generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./voca.db"
}

enum UserRole {
  ADMIN
  GURU
  WALI
}

enum StudentStatus {
  HADIR
  IZIN
  SAKIT
  ALFA
}

enum PickupMethod {
  SELF
  OTHER_PERSON
  OJOL
}

enum CallStatus {
  WAITING
  CALLING
  COMPLETED
  CANCELLED
}

model User {
  id       String   @id @default(cuid())
  username String   @unique
  pin      String
  fullName String
  role     UserRole

  guardian Guardian?

  teacherCalls Call[] @relation("TeacherCalls")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone   String?
  address String?

  students GuardianStudent[]
  pickups  PickupHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id        String        @id @default(cuid())
  nis       String        @unique
  fullName  String
  className String
  photo     String?
  status    StudentStatus @default(HADIR)
  classNote String?

  guardians GuardianStudent[]
  calls     Call[]
  pickups   PickupHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianStudent {
  id String @id @default(cuid())

  guardianId String
  studentId  String

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
}

model Call {
  id String @id @default(cuid())

  studentId String
  teacherId String

  status CallStatus @default(WAITING)

  announcement String

  calledAt   DateTime  @default(now())
  finishedAt DateTime?

  student Student @relation(fields: [studentId], references: [id])
  teacher User    @relation("TeacherCalls", fields: [teacherId], references: [id])

  pickup PickupHistory?
}

model PickupHistory {
  id String @id @default(cuid())

  callId String @unique

  studentId  String
  guardianId String?

  method PickupMethod

  otherPersonName String?
  ojolPlate       String?

  pickedAt DateTime @default(now())

  call     Call      @relation(fields: [callId], references: [id])
  student  Student   @relation(fields: [studentId], references: [id])
  guardian Guardian? @relation(fields: [guardianId], references: [id])
}

model Announcement {
  id String @id @default(cuid())

  title String
  text  String

  played Boolean @default(false)

  createdAt DateTime @default(now())
}
